# ---------------------------------------------------------------------------
# Aegis SOC Platform - Backend Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (SQLite by default - zero config, ideal for small business deployments)
# For production at scale, switch DB_DIALECT to "postgres" and set the fields below.
DB_DIALECT=sqlite
DB_STORAGE=./data/aegis-soc.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegis_soc
DB_USER=aegis_admin
DB_PASSWORD=change-me

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Alerting (SMS/Email) - stubbed providers, wire up real credentials for production
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=change-me
ALERT_EMAIL_FROM=Aegis SOC <alerts@yourcompany.com>

SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-sid
SMS_AUTH_TOKEN=your-twilio-token
SMS_FROM_NUMBER=+10000000000

# Threat Intelligence Feeds (external integrations - optional)
THREAT_FEED_API_KEY=replace-with-real-key
THREAT_FEED_REFRESH_CRON=*/30 * * * *

# Risk Scoring
CRITICAL_RISK_THRESHOLD=85
HIGH_RISK_THRESHOLD=65
MEDIUM_RISK_THRESHOLD=40
